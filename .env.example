# Copy to .env and fill in from your Supabase project (Settings -> API).
# Both are safe to expose to the browser — the server serves them to the
# frontend as-is via GET /config.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Free Hugging Face access token (huggingface.co -> Settings -> Access
# Tokens; "Read" scope is enough), used to fetch real TURN relay credentials
# from Cloudflare Realtime via https://turn.fastrtc.org/credentials — 10GB/mo
# free, no credit card. Unlike the Supabase keys above, keep this secret:
# it's never sent to the browser (see GET /api/ice-servers in server.js).
# Without it, TURN is unavailable and viewers fall back to STUN-only (direct
# P2P works, relayed connections needed by symmetric-NAT/CGNAT users don't
# — which is the current state: as of 2026-09-18, turn.fastrtc.org's DNS is
# broken account-wide (confirmed via Google's resolver + a matching GitHub
# issue), so this is unset everywhere and not worth setting until that's
# fixed. See the "turn" memory for the fuller writeup and alternatives.
HF_TOKEN=
